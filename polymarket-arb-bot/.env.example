# ═══════════════════════════════════════════════════════
#  Polymarket Arbitrage Bot — Environment Configuration
# ═══════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  For LIVE trading, you MUST set:
#    1. PRIVATE_KEY (your Polygon wallet private key)
#    2. TRADING_MODE=live
#
#  For PAPER trading (default), no wallet needed.
# ═══════════════════════════════════════════════════════

# Wallet (REQUIRED for live trading)
PRIVATE_KEY=your_polygon_wallet_private_key
POLYMARKET_FUNDER=

# Polymarket API credentials (auto-generated from private key if empty)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Mode: "paper" (simulated execution, real data) or "live" (real money)
TRADING_MODE=live

# Risk
INITIAL_BANKROLL=10.0
MAX_POSITION_SIZE=5.0
MAX_DRAWDOWN_PCT=0.20
KELLY_FRACTION=0.5

# Signal
Z_SCORE_THRESHOLD=2.0
MIN_NET_EV=0.003
BAYESIAN_PRIOR=0.5

# Execution
GAMMA=0.18
MAX_INVENTORY=3.0

# Feeds
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Logging
LOG_LEVEL=INFO
DATA_RECORD_DIR=./data
