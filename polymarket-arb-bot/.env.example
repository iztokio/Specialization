# ═══════════════════════════════════════════════════════
#  Crypto Arbitrage Bot — Environment Configuration
# ═══════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  For LIVE trading, you MUST set:
#    1. PRIVATE_KEY (your EVM wallet private key)
#    2. TRADING_MODE=live
#
#  For PAPER trading (default), no wallet needed.
#
#  NETWORK ARCHITECTURE:
#    Trading:  Hyperliquid L1 (no gas fees for trading)
#    Deposits: Arbitrum One (USDC + ETH for gas)
#    Feeds:    Binance + Coinbase WebSocket (spot BTC)
#
#  Same private key works on Hyperliquid, Arbitrum, Polygon.
# ═══════════════════════════════════════════════════════

# Wallet (REQUIRED for live trading)
# Your EVM private key — works across all EVM chains
PRIVATE_KEY=your_private_key_here

# Mode: "paper" (simulated execution, real data) or "live" (real money)
TRADING_MODE=paper

# ── Hyperliquid ──────────────────────────────────────────
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_COIN=BTC
HYPERLIQUID_VAULT=

# ── Risk ─────────────────────────────────────────────────
INITIAL_BANKROLL=100.0
MAX_POSITION_SIZE=50.0
MAX_DRAWDOWN_PCT=0.20
KELLY_FRACTION=0.5
MAX_LEVERAGE=5.0

# ── Signal ───────────────────────────────────────────────
Z_SCORE_THRESHOLD=2.0
MIN_NET_EV=0.003
BAYESIAN_PRIOR=0.5

# ── Execution ────────────────────────────────────────────
GAMMA=0.18
MAX_INVENTORY=3.0

# ── Margin Monitoring ────────────────────────────────────
MIN_MARGIN_AVAILABLE=50.0
MARGIN_CHECK_INTERVAL=10.0
FUNDING_RATE_WARN_THRESHOLD=0.01

# ── Feeds ────────────────────────────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
DATA_RECORD_DIR=./data

# ── Legacy Polymarket (deprecated) ───────────────────────
# POLYMARKET_API_KEY=
# POLYMARKET_SECRET=
# POLYMARKET_PASSPHRASE=
# POLYMARKET_FUNDER=
